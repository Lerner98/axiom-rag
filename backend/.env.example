# Axiom RAG backend settings.
# setup.ps1 creates backend/.env for you. To configure by hand: copy this file to
# .env and change what you need. Every value below is the built-in default unless noted.

# === API ===
API_HOST=0.0.0.0
API_PORT=8001
# JSON list of allowed browser origins (the Vite dev server runs on 8080)
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://localhost:3000"]
DEBUG=false

# === LLM ===
# ollama (local, default) | openai | gemini
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# llama3.1:8b needs a 6 GB+ GPU; llama3.2:3b (or llama3.2:1b under 8 GB RAM) for CPU
OLLAMA_MODEL=llama3.1:8b
# auto = Ollama decides | cpu = never use the GPU (num_gpu=0) | gpu = offload all layers
COMPUTE_DEVICE=auto
# CPU threads for Ollama, 0 = let Ollama choose
OLLAMA_NUM_THREAD=0
OLLAMA_NUM_CTX=4096

# Cloud fallbacks (only used when LLM_PROVIDER is set to them)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# === Embeddings ===
# fastembed (local ONNX on CPU, default) | openai | ollama
# Switching providers changes vector size: re-upload documents afterwards.
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# === Storage ===
CHROMA_PATH=./data/chroma
MEMORY_BACKEND=sqlite
MEMORY_DB_PATH=./data/memory.db
DATA_DIR=./data
UPLOADS_DIR=./data/uploads

# === Chunking (parent-child) ===
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50

# === Retrieval ===
RETRIEVAL_VECTOR_K=20
RETRIEVAL_BM25_K=20
RETRIEVAL_FINAL_K=5
RELEVANCE_THRESHOLD=0.3

# === Self-correction ===
MAX_RETRIES=2
HALLUCINATION_THRESHOLD=0.8
